# Values below belong in Supabase Edge Function secrets, never in the browser bundle.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
# Comma-separated exact origins; no wildcard in production.
ALLOWED_ORIGINS=https://app.example.gov,http://localhost:5173
APP_REDIRECT_URL=https://app.example.gov
# Generate independent 32-byte base64url values, for example:
# openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
SENSITIVE_DATA_ENCRYPTION_KEY=replace-with-32-byte-base64url-key
SENSITIVE_DATA_LOOKUP_KEY=replace-with-a-different-32-byte-base64url-key
# Shared secret for a server-to-server Supabase Auth audit hook only.
AUTH_EVENT_INGEST_SECRET=replace-with-long-random-secret
