# Browser-safe Supabase values only. Never put the service-role key in this file.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
# Optional: shown only in non-production environments as a configuration diagnostic.
VITE_APP_ENV=development
# Leave as / locally. GitHub Pages uses /<repository>/ automatically from its workflow.
VITE_BASE_PATH=/
# Use hash routing only for hosts without SPA rewrites, such as GitHub Pages.
# VITE_ROUTER_MODE=hash
