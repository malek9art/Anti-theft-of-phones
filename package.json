{
  "name": "himaya-device-lifecycle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Himaya — secure device lifecycle and anti-theft platform",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "tsc --noEmit",
    "check:pwa": "node --check public/sw.js && node scripts/check-pwa.mjs",
    "check:edge": "npx --yes deno check --config supabase/functions/deno.json $(find supabase/functions -mindepth 2 -maxdepth 2 -name index.ts -print | sort)",
    "check:sql": "node scripts/check-sql-balance.mjs",
    "test": "node --test tests/**/*.test.mjs",
    "test:security": "node --test tests/security/**/*.test.mjs",
    "verify": "npm run check && npm run check:pwa && npm run check:edge && npm run check:sql && npm test && npm run build && npm run secrets:check",
    "supabase:types": "supabase gen types typescript --local > src/types/database.generated.ts",
    "supabase:start": "supabase start",
    "supabase:db:reset": "supabase db reset",
    "supabase:test": "supabase test db",
    "seed:dev": "ALLOW_DEVELOPMENT_SEED=true node scripts/seed-dev.mjs",
    "secrets:check": "node scripts/validate-no-secrets.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.1"
  }
}
